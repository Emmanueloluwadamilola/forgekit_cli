# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Coverage output from `forgekit test`
coverage/

# ForgeKit generation transactions and rollback snapshots. These are local
# working state: each entry is a full snapshot of the project at the time a
# generation ran, so committing them bloats history for no benefit.
.forgekit/

# Environment values written by `forgekit add env` / `forgekit set env`.
# Review these before committing — bundled client configuration is fine, real
# secrets are not.
#assets/env/
